<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="virtux" Language="1049"
           Version="1.0.0" Manufacturer="virtux"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"/>

    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия virtux."/>
    <MediaTemplate EmbedCab="yes"/>

    <WixVariable Id="WixUIBannerBmp" Value="installer_banner.bmp"/>
    <WixVariable Id="WixUIDialogBmp" Value="installer_dialog.bmp"/>
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf"/>

    <UIRef Id="WixUI_InstallDir"/>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="virtux"/>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop"/>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="virtux"/>
      </Directory>
    </Directory>

    <Component Id="VirtuxExe" Guid="*" Directory="INSTALLFOLDER">
      <File Id="VirtuxExe" Source="..\dist\virtux.exe" KeyPath="yes"/>
    </Component>

    <Component Id="DesktopShortcut" Guid="*" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcut" Name="virtux"
                Target="[INSTALLFOLDER]virtux.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="VirtuxIcon"/>
      <RegistryValue Root="HKCU" Key="Software\virtux" Name="desktop"
                     Type="integer" Value="1" KeyPath="yes"/>
    </Component>

    <Component Id="StartMenuShortcut" Guid="*" Directory="AppMenuFolder">
      <Shortcut Id="StartMenuShortcut" Name="virtux"
                Target="[INSTALLFOLDER]virtux.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="VirtuxIcon"/>
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall"/>
      <RegistryValue Root="HKCU" Key="Software\virtux" Name="startmenu"
                     Type="integer" Value="1" KeyPath="yes"/>
    </Component>

    <Feature Id="MainFeature" Title="virtux" Level="1">
      <ComponentRef Id="VirtuxExe"/>
      <ComponentRef Id="DesktopShortcut"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>

    <Icon Id="VirtuxIcon" SourceFile="..\assets\icon.ico"/>
  </Product>
</Wix>
